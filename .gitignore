# ==========================================
# Git Ignore Configuration
# ==========================================

# Environment & Secrets (NEVER commit secrets or API keys)
.env
.env.*
*.env
*.local

# Python Environments & Caches
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# Large Model Weights & Binary Checkpoints (Exceeding GitHub thresholds / downloaded at runtime)
*.weights
*.pt
*.pth
*.h5
*.bin
*.onnx
backend/models/*.weights

# Large Media Files
*.mp4
*.avi
*.mkv
*.mov
sample_images/*.mp4

# Node & Frontend Build Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System & IDE Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
